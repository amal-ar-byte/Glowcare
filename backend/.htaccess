# ============================================================
# GlowCare Backend - Apache Configuration
# ============================================================

# Enable the rewrite engine for clean URLs
RewriteEngine On

# Handle CORS preflight requests at the server level
# Browsers send OPTIONS requests before actual API calls
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "http://localhost:3000"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
    Header always set Access-Control-Allow-Credentials "true"
</IfModule>

# Respond to OPTIONS preflight requests immediately
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Prevent directory listing for security
Options -Indexes

# Set default character encoding
AddDefaultCharset UTF-8
